DATABASE_URL=postgresql://postgres@localhost:5432/idtc_backend
# Maksimal koneksi pool (Supabase Session pooler: pakai 5).
PG_POOL_MAX=10
PORT=3100
# Kosongkan agar URL file mengikuti host request (berguna saat diakses dari HP via IP LAN).
PUBLIC_BASE_URL=
UPLOAD_DIR=./uploads
# Origin Expo web saat development (pisahkan koma). Aplikasi native tidak butuh CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:8091
# Super Admin bootstrap (dibuat otomatis saat server start bila belum ada).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin IDTC
# true bila di belakang proxy/load balancer (Hostinger Web App, Nginx).
TRUST_PROXY=false

# Login Google: client ID OAuth app (web, android, ios), pisahkan koma. Kosong = login Google nonaktif.
GOOGLE_CLIENT_IDS=
